<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Progress__c</fullName>
    <description>Formula: completed tasks divided by total tasks.</description>
    <inlineHelpText>Share of onboarding tasks completed.</inlineHelpText>
    <label>Progress</label>
    <formula>IF(Total_Tasks__c = 0, 0, Completed_Tasks__c / Total_Tasks__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Percent</type>
    <trackHistory>false</trackHistory>
</CustomField>
