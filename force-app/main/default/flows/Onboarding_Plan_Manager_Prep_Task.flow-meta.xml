<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>AU-01 (FR-03): when a plan is created, gives the hiring manager a task to write the Role Brief and assign a buddy, due five days before the start date (or today if the start is closer).</description>
    <environments>Default</environments>
    <formulas>
        <name>fmlPrepDueDate</name>
        <dataType>Date</dataType>
        <expression>IF({!$Record.Start_Date__c} - 5 &lt; {!$Flow.CurrentDate}, {!$Flow.CurrentDate}, {!$Record.Start_Date__c} - 5)</expression>
    </formulas>
    <interviewLabel>Onboarding Plan: Manager Prep Task {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Onboarding Plan: Manager Prep Task</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Prep_Task</name>
        <label>Create Prep Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Assigned_To__c</field>
            <value><elementReference>$Record.Hiring_Manager__c</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Category__c</field>
            <value><stringValue>Role</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Description__c</field>
            <value><stringValue>Before the start date, write the Role Brief on the plan (responsibilities, 30-day goals, key stakeholders) and assign a buddy. Both are required before the plan can be set to Ready.</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Due_Date__c</field>
            <value><elementReference>fmlPrepDueDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value><stringValue>Prepare the role: write the Role Brief and assign a buddy</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Onboarding_Plan__c</field>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Not Started</stringValue></value>
        </inputAssignments>
        <object>Onboarding_Task__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Create_Prep_Task</targetReference></connector>
        <object>Onboarding_Plan__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
