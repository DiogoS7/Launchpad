<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Build_Task</name>
        <label>Build Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTask.Name</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Templates.Name</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Onboarding_Plan__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Template__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Templates.Id</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Category__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Templates.Category__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Assigned_To__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fmlAssigneeId</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>fmlDueDate</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Status__c</assignToReference>
            <operator>Assign</operator>
            <value><stringValue>Not Started</stringValue></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Guide_Link__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Templates.Guide_Link__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTask.Description__c</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Loop_Templates.Description__c</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colTasks</assignToReference>
            <operator>Add</operator>
            <value><elementReference>varTask</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Loop_Templates</targetReference></connector>
    </assignments>
    <decisions>
        <name>Check_Project_Changed</name>
        <label>Check Project Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Project unchanged</defaultConnectorLabel>
        <rules>
            <name>Project_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Project__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue><elementReference>$Record__Prior.Project__c</elementReference></rightValue>
            </conditions>
            <connector><targetReference>Get_Templates</targetReference></connector>
            <label>Project Changed</label>
        </rules>
    </decisions>
    <description>AU-04 (FR-18): when a project is assigned to a plan (or changed), creates one task per active Project Assigned template for the project lead, due the template offset after the assignment date.</description>
    <environments>Default</environments>
    <formulas>
        <name>fmlAssigneeId</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Loop_Templates.Assignee_Role__c}),
  &quot;New Hire&quot;, {!$Record.New_Hire__c},
  &quot;Hiring Manager&quot;, {!$Record.Hiring_Manager__c},
  &quot;Buddy&quot;, {!$Record.Buddy__c},
  &quot;Project Lead&quot;, {!$Record.Project__r.Project_Lead__c},
  &quot;HR&quot;, {!$Record.OwnerId},
  {!$Record.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>fmlDueDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + BLANKVALUE({!Loop_Templates.Due_Offset_Days__c}, 0)</expression>
    </formulas>
    <interviewLabel>Onboarding Plan: Generate Handover Tasks {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Onboarding Plan: Generate Handover Tasks</label>
    <loops>
        <name>Loop_Templates</name>
        <label>Loop Templates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Templates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Build_Task</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Create_Tasks</targetReference></noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Tasks</name>
        <label>Create Tasks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>colTasks</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Templates</name>
        <label>Get Templates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Loop_Templates</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value><booleanValue>true</booleanValue></value>
        </filters>
        <filters>
            <field>Trigger__c</field>
            <operator>EqualTo</operator>
            <value><stringValue>Project Assigned</stringValue></value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Onboarding_Task_Template__c</object>
        <sortField>Sort_Order__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Check_Project_Changed</targetReference></connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Onboarding_Plan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>colTasks</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Onboarding_Task__c</objectType>
    </variables>
    <variables>
        <name>varTask</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Onboarding_Task__c</objectType>
    </variables>
</Flow>
