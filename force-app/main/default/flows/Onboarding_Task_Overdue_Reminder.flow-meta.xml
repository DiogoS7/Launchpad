<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Reminder</name>
        <label>Send Reminder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value><elementReference>$Record.Assigned_To__r.Email</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value><stringValue>Launchpad: an onboarding task is overdue</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value><elementReference>ttBody</elementReference></value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>AU-06 (FR-14): emails the person assigned to an onboarding task the day after its due date if it is still open. Cancelled automatically if the task is completed; rescheduled if the due date changes.</description>
    <environments>Default</environments>
    <interviewLabel>Onboarding Task: Overdue Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Onboarding Task: Overdue Reminder</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value><stringValue>Completed</stringValue></value>
        </filters>
        <filters>
            <field>Assigned_To__c</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Onboarding_Task__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Day_After_Due_Date</name>
            <connector><targetReference>Send_Reminder</targetReference></connector>
            <label>Day After Due Date</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Due_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hi {!$Record.Assigned_To__r.FirstName},

Your onboarding task &quot;{!$Record.Name}&quot; on plan {!$Record.Onboarding_Plan__r.Name} was due on {!$Record.Due_Date__c} and is still open.

Please complete it, or update its status, so the new hire is not left waiting.

Launchpad</text>
    </textTemplates>
</Flow>
